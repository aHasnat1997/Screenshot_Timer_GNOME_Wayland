{
  "name": "screenshot_timer",
  "version": "1.0.0",
  "description": "Automated sequential screenshot tool for GNOME Wayland using Bun/TypeScript",
  "main": "index.ts",
  "type": "module",
  "scripts": {
    "start": "node api.js && bun run index.ts",
    "shot": "bun run index.ts 1 3",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^5.9.3"
  }
}
